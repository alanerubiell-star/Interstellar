# --- Credenciales (sólo servidor: nunca se exponen al cliente) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Modelo ---
NOA_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Opus 5 rinde bien en niveles bajos:
# vale la pena barrerlos con evaluación clínica propia antes de fijar uno.
NOA_EFFORT=high
NOA_MAX_TOKENS=16000

# --- Servidor ---
PORT=8787
NOA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Límites ---
NOA_RATE_WINDOW_MS=60000
NOA_RATE_MAX=20
NOA_MAX_TRANSCRIPT_LINES=600

# Registra transcripciones y notas en consola. Datos personales sensibles:
# dejar en false fuera de depuración local.
NOA_LOG_CLINICAL=false

# --- Cliente (build) ---
# URL del backend para la app empaquetada (Electron / Capacitor / PWA).
# En desarrollo se deja vacío: Vite hace proxy de /api.
# VITE_NOA_API=https://api.tu-dominio.mx
